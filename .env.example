# ── AI tutor (any OpenAI-compatible endpoint) ───────────────────────────────
# Freebuff API key: Desktop → Account → Developer API
OPENAI_API_KEY=
AI_BASE_URL=https://freebuff.com/api/v1/paid
TUTOR_MODEL=gpt-4o-mini

# ── Voice engine ────────────────────────────────────────────────────────────
# The app speaks with a native-accent neural voice. Configure ONE of these.
# Server-side providers are tried in this order; with none configured the app
# falls back to the best voice installed in the learner's browser.
#
# 1. Azure Speech  ← recommended: native Thai (Premwadee) + Japanese (Nanami)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Optional per-language voice overrides (neural voice names)
# AZURE_VOICE_TH=th-TH-PremwadeeNeural
# AZURE_VOICE_JA=ja-JP-NanamiNeural
# AZURE_VOICE_ES=es-ES-ElviraNeural
# AZURE_VOICE_FR=fr-FR-DeniseNeural

# 2. Google Cloud Text-to-Speech
GOOGLE_TTS_API_KEY=
# GOOGLE_VOICE_TH=th-TH-Neural2-C
# GOOGLE_VOICE_JA=ja-JP-Neural2-B

# 3. ElevenLabs (multilingual v2 — set a voice id per language)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_TH=
ELEVENLABS_VOICE_JA=
ELEVENLABS_VOICE_ES=
ELEVENLABS_VOICE_FR=
